  "name": "doc_cookbook_frontend_contactform",
  "page_url": {
    "en": "https://zotonic.com/cookbook/1582/implementing-a-simple-contact-form",
    "x-default": "https://zotonic.com/cookbook/1582/implementing-a-simple-contact-form"
